{# The Ghostwriter widget on Craft's dashboard. #}
<div class="gw-widget">
    {% if not configured %}
        <p class="warning with-icon smalltext">{{ 'Ghostwriter has no API key yet.'|t('ghostwriter') }}</p>
    {% endif %}

    {% if (stock.previews ?? 0) > 0 %}
        <p class="warning with-icon smalltext"><a href="{{ cpUrl('ghostwriter/stock') }}">{{ '{count, plural, =1{1 stock preview to license} other{# stock previews to license}}'|t('ghostwriter', {count: stock.previews}) }}</a></p>
    {% endif %}

    {% if not setup.complete and not setup.hidden %}
        <a class="gw-widget__setup" href="{{ cpUrl('ghostwriter/setup') }}{{ nextStep ? '#step-' ~ nextStep.number }}">
            <span>
                {{ 'Get started · {done} of {total} done'|t('ghostwriter', {done: setup.done, total: setup.total}) }}
                {% if nextStep %}<span class="gw-widget__next light">{{ 'Next: {title}'|t('ghostwriter', {title: nextStep.title}) }}</span>{% endif %}
            </span>
            <span class="gw-progress gw-progress--wide" aria-hidden="true"><span style="width: {{ (setup.done / setup.total * 100)|round }}%"></span></span>
        </a>
    {% endif %}

    <div class="gw-widget__stats">
        <a href="{{ cpUrl('ghostwriter#gw-in-progress') }}">
            <strong>{{ inProgress|length + moreInProgress }}</strong>
            <span class="light">{{ 'in progress'|t('ghostwriter') }}</span>
        </a>
        <a href="{{ cpUrl('ghostwriter/plan') }}">
            <strong>{{ planOpen }}</strong>
            <span class="light">{{ '{count, plural, =1{idea waiting} other{ideas waiting}}'|t('ghostwriter', {count: planOpen}) }}</span>
        </a>
    </div>

    {% if inProgress|length %}
        <ul class="gw-widget__list">
            {% for s in inProgress %}
                <li>
                    {% if s.url %}<a href="{{ s.url }}">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %}
                    <span class="light smalltext">{{ s.section ?? s.type }}{{ s.startedBy ? ' · ' ~ 'Started by {name}'|t('ghostwriter', {name: s.startedBy}) }}</span>
                </li>
            {% endfor %}
        </ul>
        {% if moreInProgress %}
            <p class="smalltext"><a href="{{ cpUrl('ghostwriter#gw-in-progress') }}">{{ 'and {count} more'|t('ghostwriter', {count: moreInProgress}) }}</a></p>
        {% endif %}
    {% else %}
        <p class="light smalltext">{{ 'Nothing being written right now.'|t('ghostwriter') }}</p>
    {% endif %}

    {# Without a key, Write something stays in view but switched off, so it is clear what Ghostwriter does once it has one. #}
    <div class="gw-widget__write">
        {% if sections|length %}
            {% if configured %}
                <button type="button" class="btn small submit menubtn">{{ 'Write something'|t('ghostwriter') }}</button>
                <div class="menu">
                    <ul>
                        {% for section in sections %}
                            <li><a href="{{ cpUrl('ghostwriter/write/' ~ section.handle) }}">{{ section.name }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <button type="button" class="btn small submit disabled" disabled title="{{ 'Add the API key first.'|t('ghostwriter') }}">{{ 'Write something'|t('ghostwriter') }}</button>
            {% endif %}
        {% endif %}
        <a class="btn small" href="{{ cpUrl('ghostwriter') }}">{{ 'Open Ghostwriter'|t('ghostwriter') }}</a>
    </div>
</div>
