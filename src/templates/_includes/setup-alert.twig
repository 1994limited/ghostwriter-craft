{# Shown on every screen while the chosen provider has no API key, since nothing that calls a model can work until one is set. #}
{% if not configured %}
    <div class="readable gw-alert">
        <p class="warning with-icon">
            <strong>{{ 'No API key yet.'|t('ghostwriter') }}</strong>
            {{ 'Set up {provider} in Connections (or set {key} in .env). Ghostwriter cannot write anything until then.'|t('ghostwriter', {provider: provider, key: keyName ?? ('the API key for “' ~ provider ~ '”')}) }}
            <a href="{{ cpUrl('ghostwriter/connections') }}">{{ 'Set up in Connections'|t('ghostwriter') }}</a>
        </p>
    </div>
{% endif %}
