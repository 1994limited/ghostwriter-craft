{#
    Plugin settings. API keys are never entered here: they are read from the
    environment, and this screen only says which are set.
#}
{% import '_includes/forms' as forms %}

{#
    Config wins over this screen: a setting in config/ghostwriter.php is
    shown locked, with a note saying where it is set. Craft shows a warning
    for any non-empty value, so a setting that is not overridden gets null.
#}
{% macro overridden(setting, overrides) -%}
    {{- 'Set by `{setting}` in config/ghostwriter.php, which wins over this screen.'|t('ghostwriter', {setting: setting})|md(inlineOnly=true) -}}
{%- endmacro %}

{% set sectionOptions = sections|map(section => {label: section.name|t('site'), value: section.handle}) %}

<h2>{{ 'Sections'|t('ghostwriter') }}</h2>

{{ forms.checkboxSelectField({
    label: 'Write for these sections'|t('ghostwriter'),
    instructions: 'A “Write with Ghostwriter” button appears on the entry screens of each one. Tick none to offer every section.'|t('ghostwriter'),
    name: 'sections',
    options: sectionOptions,
    values: settings.sections,
    warning: 'sections' in overrides ? _self.overridden('sections', overrides) : null,
    disabled: 'sections' in overrides,
}) }}

{{ forms.checkboxSelectField({
    label: 'Learn the voice from these sections'|t('ghostwriter'),
    instructions: 'Read when the tone of voice guide is generated. Tick none to read every section.'|t('ghostwriter'),
    name: 'voiceSections',
    options: sectionOptions,
    values: settings.voiceSections,
    warning: 'voiceSections' in overrides ? _self.overridden('voiceSections', overrides) : null,
    disabled: 'voiceSections' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'Show Get started'|t('ghostwriter'),
    instructions: 'The setup steps at the top of the Overview and in the menu. Turn this back on to bring them back after hiding them.'|t('ghostwriter'),
    name: 'showGetStarted',
    on: settings.showGetStarted,
}) }}

{{ forms.lightswitchField({
    label: 'Suggest kinds of content automatically'|t('ghostwriter'),
    instructions: 'When Get started’s kinds step opens, Ghostwriter looks at each section never looked at, or with ten or more entries published since the last look, and suggests the kinds of content worth teaching it. Each look is one model call. Elsewhere it only looks when you click Suggest kinds.'|t('ghostwriter'),
    name: 'suggestKindsAutomatically',
    on: settings.suggestKindsAutomatically,
    warning: 'suggestKindsAutomatically' in overrides ? _self.overridden('suggestKindsAutomatically', overrides) : null,
    disabled: 'suggestKindsAutomatically' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'New entries start unpublished'|t('ghostwriter'),
    instructions: 'When a draft goes into a new entry, its Enabled switch is turned off, so it can be saved straight away and isn’t published by accident. Switch on Enabled when it’s ready. Existing entries are never changed.'|t('ghostwriter'),
    name: 'draftsUnpublished',
    on: settings.draftsUnpublished,
    warning: 'draftsUnpublished' in overrides ? _self.overridden('draftsUnpublished', overrides) : null,
    disabled: 'draftsUnpublished' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'Share conversations'|t('ghostwriter'),
    instructions: 'Everyone who may use Ghostwriter sees every piece being written, and can carry it on, with each message showing who sent it. Off, each person sees only the pieces they started.'|t('ghostwriter'),
    name: 'sharedConversations',
    on: settings.sharedConversations,
    warning: 'sharedConversations' in overrides ? _self.overridden('sharedConversations', overrides) : null,
    disabled: 'sharedConversations' in overrides,
}) }}

<hr>

<h2>{{ 'AI provider'|t('ghostwriter') }}</h2>

{{ forms.selectField({
    label: 'Provider'|t('ghostwriter'),
    name: 'provider',
    options: {anthropic: 'Claude (Anthropic)', openai: 'ChatGPT (OpenAI)', gemini: 'Gemini (Google)'},
    value: settings.provider,
    warning: 'provider' in overrides ? _self.overridden('provider', overrides) : null,
    disabled: 'provider' in overrides,
}) }}

{{ forms.textField({
    label: 'Model'|t('ghostwriter'),
    instructions: 'Leave blank to use the provider’s default model.'|t('ghostwriter'),
    name: 'model',
    value: settings.model,
    placeholder: modelDefaults[settings.provider] ?? '',
    warning: 'model' in overrides ? _self.overridden('model', overrides) : settings.modelWarning(),
    disabled: 'model' in overrides,
}) }}

<h3>{{ 'Gateways and proxies'|t('ghostwriter') }}</h3>
<p class="light">{{ 'Only if you send requests through a gateway or proxy that speaks the provider’s own API. Leave blank to call each provider at its own address. It must be an https:// address; http:// is allowed only for localhost.'|t('ghostwriter') }}</p>

{% for handle, label in {anthropic: 'Claude (Anthropic)', openai: 'ChatGPT (OpenAI)', gemini: 'Gemini (Google)'} %}
    {{ forms.autosuggestField({
        label: '{provider} base URL'|t('ghostwriter', {provider: label}),
        instructions: 'An address, or an environment variable such as `${name}`.'|t('ghostwriter', {name: 'GHOSTWRITER_' ~ handle|upper ~ '_BASE_URL'}),
        id: 'baseUrls-' ~ handle,
        name: 'baseUrls[' ~ handle ~ ']',
        value: settings.baseUrls[handle] ?? '',
        suggestEnvVars: true,
        placeholder: 'https://',
        errors: settings.getErrors('baseUrls.' ~ handle),
        warning: 'baseUrls' in overrides ? _self.overridden('baseUrls', overrides) : null,
        disabled: 'baseUrls' in overrides,
    }) }}
{% endfor %}

<hr>

<h2>{{ 'Images'|t('ghostwriter') }}</h2>
<p class="light">{{ 'Images are made by ChatGPT or Gemini; Claude cannot make them. Each image is modelled on the ones already used in the same field on your other entries. Without a key, free photographs can still be searched for: Openverse needs no key, and Unsplash, Pixabay and Pexels keys add those libraries.'|t('ghostwriter') }}</p>

{{ forms.selectField({
    label: 'Image provider'|t('ghostwriter'),
    instructions: 'Leave on “Whichever has a key” unless both do.'|t('ghostwriter'),
    name: 'imageProvider',
    options: {'': 'Whichever has a key'|t('ghostwriter'), openai: 'ChatGPT (OpenAI)', gemini: 'Gemini (Google)'},
    value: settings.imageProvider ?? '',
    warning: 'imageProvider' in overrides ? _self.overridden('imageProvider', overrides) : null,
    disabled: 'imageProvider' in overrides,
}) }}

{{ forms.textField({
    label: 'Image model'|t('ghostwriter'),
    instructions: 'Leave blank to use the provider’s default model.'|t('ghostwriter'),
    name: 'imageModel',
    value: settings.imageModel,
    warning: 'imageModel' in overrides ? _self.overridden('imageModel', overrides) : null,
    disabled: 'imageModel' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'Mark images still to choose'|t('ghostwriter'),
    instructions: 'When a draft is put into a new entry, image fields it leaves empty get a striped placeholder where the section’s pages usually have an image, so the layout shows where pictures go. Replace them before publishing.'|t('ghostwriter'),
    name: 'placeholderImages',
    on: settings.placeholderImages,
    warning: 'placeholderImages' in overrides ? _self.overridden('placeholderImages', overrides) : null,
    disabled: 'placeholderImages' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'Search Openverse'|t('ghostwriter'),
    instructions: 'Public-domain and CC0 photographs, with no key needed.'|t('ghostwriter'),
    name: 'openverse',
    on: settings.openverse,
    warning: 'openverse' in overrides ? _self.overridden('openverse', overrides) : null,
    disabled: 'openverse' in overrides,
}) }}

<hr>

<h2>{{ 'Troubleshooting'|t('ghostwriter') }}</h2>

{{ forms.booleanMenuField({
    label: 'Log replies that can’t be read'|t('ghostwriter'),
    instructions: 'When a model’s reply can’t be read, put the whole reply in Craft’s log, under the ghostwriter category. Off, only what was wrong with it is logged. Replies hold your content, so turn this on only while looking into a problem. Prompts and API keys are never logged.'|t('ghostwriter'),
    id: 'logReplies',
    name: 'logReplies',
    value: settings.logReplies is same as(true) ? '1' : (settings.logReplies is same as(false) ? '0' : settings.logReplies),
    includeEnvVars: true,
    warning: 'logReplies' in overrides ? _self.overridden('logReplies', overrides) : null,
    disabled: 'logReplies' in overrides,
}) }}

<hr>

<h2>{{ 'API keys'|t('ghostwriter') }}</h2>
<p class="light">{{ 'Keys are read from your .env file each time they are needed and are never stored by Ghostwriter.'|t('ghostwriter') }}</p>

<table class="data fullwidth">
    <tbody>
        {% for name, set in keys %}
            <tr>
                <th scope="row"><code>{{ name }}</code></th>
                <td>
                    {% if set %}
                        <span class="status green" aria-hidden="true"></span>{{ 'Set'|t('ghostwriter') }}
                    {% else %}
                        <span class="status" aria-hidden="true"></span><span class="light">{{ 'Not set'|t('ghostwriter') }}</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
