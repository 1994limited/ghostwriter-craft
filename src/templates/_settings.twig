{# Connect with OpenRouter, per core's docs/connecting-accounts.md. #}
<div class="field gw-openrouter" id="openrouter">
    <div class="heading"><label id="gw-openrouter-label">OpenRouter</label></div>
    <div class="input" role="group" aria-labelledby="gw-openrouter-label">
        {% if openrouter.source == 'env' %}
            <p><span class="status green" aria-hidden="true"></span>{{ 'Using OPENROUTER_API_KEY from .env'|t('ghostwriter') }}</p>
        {% elseif openrouter.source == 'connected' %}
            <p><span class="status green" aria-hidden="true"></span>{{ 'Connected to OpenRouter ({key})'|t('ghostwriter', {key: openrouter.masked}) }}</p>
        {% else %}
            <p><span class="status" aria-hidden="true"></span>{{ 'Not connected'|t('ghostwriter') }}</p>
            <p class="light">{{ 'Sign in to OpenRouter to use Claude, GPT or Gemini with one account, paid for with OpenRouter credit.'|t('ghostwriter') }}</p>
        {% endif %}
        <div class="flex">
            {% if openrouter.source is null %}
                {% if canManage %}<a class="btn submit" href="{{ openrouter.connectUrl }}">{{ 'Connect with OpenRouter'|t('ghostwriter') }}</a>{% endif %}
            {% else %}
                <button type="button" class="btn gw-openrouter-check">{{ 'Check connection'|t('ghostwriter') }}</button>
                {% if openrouter.source == 'connected' and canManage %}
                    <button type="button" class="btn gw-openrouter-disconnect">{{ 'Disconnect'|t('ghostwriter') }}</button>
                {% endif %}
            {% endif %}
        </div>
        <div class="gw-openrouter-result light smalltext" aria-live="polite"></div>
        {% if openrouter.source == 'connected' %}
            <p class="light smalltext">{{ 'Disconnect only forgets the key here. To revoke it, delete the key at openrouter.ai/settings/keys.'|t('ghostwriter') }}</p>
        {% endif %}
        {% if settings.provider == 'openrouter' or settings.imageProvider == 'openrouter' %}
            <p class="notice with-icon">{{ 'Requests, including images, pass through OpenRouter on their way to the model’s company.'|t('ghostwriter') }}</p>
        {% endif %}
    </div>
</div>

{% for tier, label in {writing: 'OpenRouter model for writing'|t('ghostwriter'), quick: 'OpenRouter model for quick jobs'|t('ghostwriter')} %}
    {{ forms.selectField({
        label: label,
        instructions: tier == 'writing'
            ? 'With OpenRouter: the brief, the drafts, the guides and the plan. The Model setting above, when set, wins.'|t('ghostwriter')
            : 'With OpenRouter: finding and choosing photos, and quick fixes in Finish this page.'|t('ghostwriter'),
        id: 'openrouterModels-' ~ tier,
        name: 'openrouterModels[' ~ tier ~ ']',
        options: [{label: 'Default ({model})'|t('ghostwriter', {model: openrouterTiers[tier]}), value: ''}]
            |merge(openrouterChoices|map((name, id) => {label: name, value: id})|values)
            |merge((settings.openrouterModels[tier] ?? '') is not empty and (settings.openrouterModels[tier]) not in openrouterChoices|keys ? [{label: settings.openrouterModels[tier], value: settings.openrouterModels[tier]}] : []),
        value: settings.openrouterModels[tier] ?? '',
        errors: settings.getErrors('openrouterModels.' ~ tier),
        warning: 'openrouterModels' in overrides ? _self.overridden('openrouterModels', overrides) : null,
        disabled: 'openrouterModels' in overrides,
    }) }}
{% endfor %}

