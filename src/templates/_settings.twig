{% js %}
(function () {
    // Connect with OpenRouter: Check connection and Disconnect.
    const openrouter = document.querySelector('.gw-openrouter');

    openrouter?.querySelector('.gw-openrouter-check')?.addEventListener('click', async function (event) {
        const button = event.currentTarget;
        const result = openrouter.querySelector('.gw-openrouter-result');
        button.classList.add('loading');
        result.textContent = '';

        try {
            const response = await Craft.sendActionRequest('POST', 'ghostwriter/providers/check', { params: { id: 'openrouter' } });
            result.textContent = response.data.message;
            result.classList.toggle('error', Boolean(response.data.exhausted));
        } catch (error) {
            result.textContent = error?.response?.data?.message ?? Craft.t('ghostwriter', 'Something went wrong.');
            result.classList.add('error');
        } finally {
            button.classList.remove('loading');
        }
    });

    openrouter?.querySelector('.gw-openrouter-disconnect')?.addEventListener('click', async function (event) {
        const button = event.currentTarget;
        button.classList.add('loading');

        try {
            const response = await Craft.sendActionRequest('POST', 'ghostwriter/providers/disconnect', { params: { id: 'openrouter' } });
            Craft.cp.displayNotice(response.data.message);
            window.location.reload();
        } catch (error) {
            Craft.cp.displayError(error?.response?.data?.message ?? Craft.t('ghostwriter', 'Something went wrong.'));
            button.classList.remove('loading');
        }
    });

    document.querySelectorAll('.gw-stock-disconnect').forEach(function (button) {
        button.addEventListener('click', async function () {
            button.classList.add('loading');

            try {
                const response = await Craft.sendActionRequest('POST', 'ghostwriter/libraries/disconnect', { params: { id: button.dataset.library } });
                Craft.cp.displayNotice(response.data.message);
                window.location.reload();
            } catch (error) {
                Craft.cp.displayError(error?.response?.data?.message ?? Craft.t('ghostwriter', 'Something went wrong.'));
                button.classList.remove('loading');
            }
        });
    });

    document.querySelectorAll('.gw-stock-check').forEach(function (button) {
        button.addEventListener('click', async function () {
            const result = button.parentNode.querySelector('.gw-stock-check-result');
            button.classList.add('loading');
            result.textContent = '';

            try {
                const response = await Craft.sendActionRequest('POST', 'ghostwriter/stock/check', { data: { library: button.dataset.library } });
                const data = response.data;
                result.textContent = [data.account, ...(data.products || [])].filter(Boolean).join(' · ');
                result.classList.remove('error');
            } catch (error) {
                result.textContent = error?.response?.data?.message ?? Craft.t('ghostwriter', 'Something went wrong.');
                result.classList.add('error');
            } finally {
                button.classList.remove('loading');
            }
        });
    });
})();
{% endjs %}

