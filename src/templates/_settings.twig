{#
    Plugin settings. API keys are never entered here: they are read from the
    environment, and this screen only says which are set.
#}
{% import '_includes/forms' as forms %}

{#
    Config wins over this screen: a setting in config/ghostwriter.php is
    shown locked, with a note saying where it is set. Craft shows a warning
    for any non-empty value, so a setting that is not overridden gets null.
#}
{% macro overridden(setting, overrides) -%}
    {{- 'Set by `{setting}` in config/ghostwriter.php, which wins over this screen.'|t('ghostwriter', {setting: setting})|md(inlineOnly=true) -}}
{%- endmacro %}

{% set providerNames = providerNames ?? {anthropic: 'Claude (Anthropic)', openai: 'ChatGPT (OpenAI)', gemini: 'Gemini (Google)', openrouter: 'OpenRouter'} %}
{% set openrouter = openrouter ?? {source: null, masked: null, connectUrl: cpUrl('ghostwriter/providers/openrouter/connect')} %}
{% set openrouterTiers = openrouterTiers ?? {writing: '', quick: ''} %}
{% set openrouterChoices = openrouterChoices ?? {} %}
{% set canManage = canManage ?? false %}
{% set stock = stock ?? {free: [], paid: [], sources: [{label: 'Free libraries'|t('ghostwriter'), value: 'free'}]} %}

{% set sectionOptions = sections|map(section => {label: section.name|t('site'), value: section.handle}) %}

<h2>{{ 'Sections'|t('ghostwriter') }}</h2>

{{ forms.checkboxSelectField({
    label: 'Write for these sections'|t('ghostwriter'),
    instructions: 'A “Write with Ghostwriter” button appears on the entry screens of each one. Tick none to offer every section.'|t('ghostwriter'),
    name: 'sections',
    options: sectionOptions,
    values: settings.sections,
    warning: 'sections' in overrides ? _self.overridden('sections', overrides) : null,
    disabled: 'sections' in overrides,
}) }}

{{ forms.checkboxSelectField({
    label: 'Learn the voice from these sections'|t('ghostwriter'),
    instructions: 'Read when the tone of voice guide is generated. Tick none to read every section.'|t('ghostwriter'),
    name: 'voiceSections',
    options: sectionOptions,
    values: settings.voiceSections,
    warning: 'voiceSections' in overrides ? _self.overridden('voiceSections', overrides) : null,
    disabled: 'voiceSections' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'Show Get started'|t('ghostwriter'),
    instructions: 'The setup steps at the top of the Overview and in the menu. Turn this back on to bring them back after hiding them.'|t('ghostwriter'),
    name: 'showGetStarted',
    on: settings.showGetStarted,
}) }}

{{ forms.lightswitchField({
    label: 'Suggest kinds of content automatically'|t('ghostwriter'),
    instructions: 'When Get started’s kinds step opens, Ghostwriter looks at each section never looked at, or with ten or more entries published since the last look, and suggests the kinds of content worth teaching it. Each look is one model call. Elsewhere it only looks when you click Suggest kinds.'|t('ghostwriter'),
    name: 'suggestKindsAutomatically',
    on: settings.suggestKindsAutomatically,
    warning: 'suggestKindsAutomatically' in overrides ? _self.overridden('suggestKindsAutomatically', overrides) : null,
    disabled: 'suggestKindsAutomatically' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'New entries start unpublished'|t('ghostwriter'),
    instructions: 'When a draft goes into a new entry, its Enabled switch is turned off, so it can be saved straight away and isn’t published by accident. Switch on Enabled when it’s ready. Existing entries are never changed.'|t('ghostwriter'),
    name: 'draftsUnpublished',
    on: settings.draftsUnpublished,
    warning: 'draftsUnpublished' in overrides ? _self.overridden('draftsUnpublished', overrides) : null,
    disabled: 'draftsUnpublished' in overrides,
}) }}

{{ forms.lightswitchField({
    label: 'Share conversations'|t('ghostwriter'),
    instructions: 'Everyone who may use Ghostwriter sees every piece being written, and can carry it on, with each message showing who sent it. Off, each person sees only the pieces they started.'|t('ghostwriter'),
    name: 'sharedConversations',
    on: settings.sharedConversations,
    warning: 'sharedConversations' in overrides ? _self.overridden('sharedConversations', overrides) : null,
    disabled: 'sharedConversations' in overrides,
}) }}

<hr>

<h2 id="ai-provider">{{ 'AI provider'|t('ghostwriter') }}</h2>

{{ forms.selectField({
    label: 'Provider'|t('ghostwriter'),
    instructions: 'OpenRouter gives Claude, GPT or Gemini through one account, paid for with OpenRouter credit.'|t('ghostwriter'),
    name: 'provider',
    options: providerNames,
    value: settings.provider,
    warning: 'provider' in overrides ? _self.overridden('provider', overrides) : null,
    disabled: 'provider' in overrides,
}) }}

{{ forms.textField({
    label: 'Model'|t('ghostwriter'),
    instructions: 'Leave blank to use the provider’s default model.'|t('ghostwriter'),
    name: 'model',
    value: settings.model,
